---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<footer class="border-t border-white/10 bg-[var(--color-ink)]">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
    <div class="relative overflow-hidden rounded-3xl border border-[var(--color-accent)]/25 bg-gradient-to-br from-zinc-900 via-black to-zinc-950 p-8 sm:p-12 mb-12">
      <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-[var(--color-accent)]/10 blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="relative z-10 grid lg:grid-cols-[1.2fr_0.8fr] gap-10 items-center">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-[var(--color-accent)] font-extrabold mb-4">Domain available for acquisition</p>
          <h2 class="font-display text-3xl sm:text-4xl tracking-tight mb-4 text-white">
            {SITE.name} — a category-defining digital asset
          </h2>
          <p class="text-zinc-400 max-w-xl leading-relaxed">
            Positioned at the intersection of electronic design and generative AI creativity. Inquire for pricing confirmation, transfer logistics, and escrow options.
          </p>
        </div>
        <div class="glass rounded-2xl p-6 sm:p-8 border border-white/10">
          <p class="text-xs uppercase tracking-[0.16em] text-zinc-500 font-semibold mb-2">Acquisition contact</p>
          <a href={ACQUISITION_MAILTO} class="block text-xl sm:text-2xl font-display text-white hover:text-[var(--color-accent)] transition-colors break-all">
            {SITE.email}
          </a>
          <a href={ACQUISITION_MAILTO} class="btn-accent mt-6 w-full">Inquire about acquisition</a>
          <p class="mt-4 text-[11px] text-zinc-500 text-center tracking-wide">Confidential · Response within 24 hours</p>
        </div>
      </div>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-3 text-sm text-zinc-400 mb-10" aria-label="Footer">
      <a href="/" class="hover:text-white min-h-12 inline-flex items-center">Home</a>
      <a href="/portfolio/" class="hover:text-white min-h-12 inline-flex items-center">Marketplace</a>
      <a href="/blog/" class="hover:text-white min-h-12 inline-flex items-center">Guides</a>
      <a href="/#acquire" class="hover:text-white min-h-12 inline-flex items-center">Acquire</a>
      <a href="/changelog/" class="hover:text-white min-h-12 inline-flex items-center">Changelog</a>
    </nav>

    <p class="text-xs text-zinc-500 leading-relaxed max-w-4xl mb-10">
      This website is for demonstration and informational purposes only. It does not constitute an offer of services,
      a commitment to deploy, or a guarantee of outcomes. Statistics and projections are based on publicly available
      information and are subject to change.
    </p>

    <div class="pt-8 border-t border-white/10 text-xs text-zinc-500 flex flex-col md:flex-row gap-y-4 items-center justify-between">
      <div>© {new Date().getFullYear()} {SITE.name}. All rights reserved.</div>
      <div>Premium domain listing by owner · Cloudflare Workers &amp; Pages</div>
    </div>
  </div>
</footer>
