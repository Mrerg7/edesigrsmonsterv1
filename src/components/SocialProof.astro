---
import { TESTIMONIALS, RECENT_SALES } from '../data/testimonials';
---

<section class="border-y border-white/10 bg-zinc-900/40 py-16" aria-labelledby="proof-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="proof-heading" class="font-display text-[2rem] sm:text-[2.5rem] tracking-tight mb-3">
      Social proof from serious buyers
    </h2>
    <p class="text-zinc-400 mb-10 max-w-2xl">
      Testimonials and recent sales from our domain marketplace network — escrow-backed, transfer-verified.
    </p>

    <div class="grid md:grid-cols-3 gap-5 mb-12">
      {TESTIMONIALS.map((t) => (
        <blockquote class="border border-white/10 rounded-2xl p-5 bg-white/[0.02]">
          <p class="text-zinc-300 text-[15px] leading-relaxed mb-4">“{t.quote}”</p>
          <footer>
            <cite class="not-italic font-semibold text-white">{t.name}</cite>
            <p class="text-xs text-zinc-500 mt-1">{t.role}</p>
          </footer>
        </blockquote>
      ))}
    </div>

    <h3 class="font-semibold text-lg mb-4 text-white">Recent sales</h3>
    <ul class="grid sm:grid-cols-3 gap-4">
      {RECENT_SALES.map((sale) => (
        <li class="border border-white/10 rounded-2xl px-4 py-4">
          <p class="font-display text-xl text-white">{sale.domain}</p>
          <p class="text-[var(--color-accent)] font-semibold mt-1">{sale.priceLabel}</p>
          <p class="text-xs text-zinc-500 mt-1">{sale.note}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
