---
import { ACQUISITION_MAILTO, SITE } from '../config/site';
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/10 bg-[var(--color-ink)]/80 backdrop-blur-lg" id="nav" aria-label="Primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between gap-3">
    <a href="/" class="flex items-center gap-2 min-h-12" aria-label={`${SITE.name} home`}>
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[var(--color-accent)] to-[var(--color-signal)] flex items-center justify-center shrink-0">
        <span class="text-zinc-950 font-black text-xl tracking-tighter">eD</span>
      </div>
      <div class="leading-none">
        <span class="font-display text-xl sm:text-2xl font-bold tracking-tight">{SITE.brand}</span>
        <span class="text-[10px] sm:text-xs text-zinc-500 font-mono tracking-[0.2em] ml-0.5">.MONSTER</span>
      </div>
    </a>

    <div class="hidden lg:flex items-center gap-7 text-sm">
      <a href="/#why" class="hover:text-white transition-colors text-zinc-400 min-h-12 inline-flex items-center">Why This Domain</a>
      <a href="/portfolio/" class="hover:text-white transition-colors text-zinc-400 min-h-12 inline-flex items-center">Marketplace</a>
      <a href="/blog/" class="hover:text-white transition-colors text-zinc-400 min-h-12 inline-flex items-center">Guides</a>
      <a href="/#acquire" class="hover:text-white transition-colors text-zinc-400 min-h-12 inline-flex items-center">Acquire</a>
    </div>

    <div class="flex items-center gap-2 sm:gap-3">
      <button
        type="button"
        id="theme-toggle"
        class="min-h-12 min-w-12 inline-flex items-center justify-center rounded-2xl border border-white/15 hover:bg-white/5 transition-colors"
        aria-label="Toggle light and dark mode"
      >
        <svg class="w-5 h-5 theme-icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5Z" />
        </svg>
        <svg class="w-5 h-5 theme-icon-light hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <a href="/#acquire" class="hidden sm:inline-flex btn-primary text-sm px-5">Buy Now</a>
      <a href={ACQUISITION_MAILTO} class="hidden md:inline-flex btn-secondary text-sm px-4">Contact Agent</a>

      <button
        type="button"
        id="menu-toggle"
        class="lg:hidden min-h-12 min-w-12 inline-flex items-center justify-center rounded-2xl border border-white/15"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[var(--color-ink)]/95 backdrop-blur-xl">
    <div class="px-4 py-4 flex flex-col gap-1 text-base">
      <a href="/#why" class="min-h-12 px-3 rounded-xl hover:bg-white/5 inline-flex items-center">Why This Domain</a>
      <a href="/portfolio/" class="min-h-12 px-3 rounded-xl hover:bg-white/5 inline-flex items-center">Marketplace</a>
      <a href="/blog/" class="min-h-12 px-3 rounded-xl hover:bg-white/5 inline-flex items-center">Guides</a>
      <a href="/#acquire" class="min-h-12 px-3 rounded-xl hover:bg-white/5 inline-flex items-center">Acquire</a>
      <a href={ACQUISITION_MAILTO} class="min-h-12 px-3 rounded-xl hover:bg-white/5 inline-flex items-center">Contact Agent</a>
      <a href="/#acquire" class="btn-primary mt-2">Buy Now — {SITE.priceDisplay}</a>
    </div>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const themeToggle = document.getElementById('theme-toggle');

  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });

  function syncThemeIcons(light: boolean) {
    document.querySelectorAll('.theme-icon-dark').forEach((el) => el.classList.toggle('hidden', light));
    document.querySelectorAll('.theme-icon-light').forEach((el) => el.classList.toggle('hidden', !light));
  }

  syncThemeIcons(localStorage.getItem('theme') === 'light');

  themeToggle?.addEventListener('click', () => {
    const light = !document.body.classList.contains('light');
    document.body.classList.toggle('light', light);
    document.body.classList.toggle('dark', !light);
    document.documentElement.classList.toggle('light', light);
    document.documentElement.classList.toggle('dark', !light);
    localStorage.setItem('theme', light ? 'light' : 'dark');
    syncThemeIcons(light);
  });
</script>
