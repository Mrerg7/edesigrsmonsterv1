---
import { ACQUISITION_MAILTO } from '../config/site';
---

<section class="border-t border-white/10 bg-zinc-900 py-16">
  <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="font-display text-3xl sm:text-4xl tracking-tight mb-4">
      Ready to own the future of electronic design?
    </h2>
    <p class="text-zinc-400 mb-8">This domain will not stay available indefinitely. Secure it before competitors do.</p>
    <a href={ACQUISITION_MAILTO} class="btn-primary text-lg px-10" data-cta="closing">
      Start the conversation
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
    </a>
    <p class="mt-6 text-xs text-zinc-500">Direct from owner · Confidential inquiries welcome</p>
  </div>
</section>
