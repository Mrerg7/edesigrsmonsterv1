---
import { SITE } from '../config/site';
---

<section class="max-w-4xl mx-auto px-4 sm:px-6 pb-16">
  <h2 class="font-display text-2xl sm:text-3xl md:text-4xl tracking-tight mb-4">
    This is more than a domain.
  </h2>
  <p class="text-zinc-400 text-lg leading-relaxed mb-4">
    {SITE.name} is strategic brand infrastructure for teams that want to own the electronic design + AI creative conversation — not rent attention with ads forever.
  </p>
  <p class="text-zinc-400 leading-relaxed">
    Explore related inventory on the <a href="/portfolio/" class="text-[var(--color-accent)] underline-offset-4 hover:underline">domain marketplace</a>
    or read our <a href="/blog/" class="text-[var(--color-accent)] underline-offset-4 hover:underline">valuation guides</a> before you buy.
  </p>
</section>
