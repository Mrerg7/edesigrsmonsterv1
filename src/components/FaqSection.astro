---
const faqs = [
  {
    q: 'Is the price negotiable?',
    a: 'The listed price of $125,000 reflects premium positioning and AI creative market timing. Reasonable offers from qualified buyers will be considered via Make Offer.',
  },
  {
    q: 'How does the transfer process work?',
    a: 'We use reputable escrow services (Escrow.com or Dan.com recommended). You pay into escrow, we initiate registrar transfer, and funds release only after successful confirmation.',
  },
  {
    q: 'Why .monster instead of .com?',
    a: '.monster delivers distinctive creative energy that matches electronic design and AI art. It is memorable, short, and increasingly recognized in creative tech circles.',
  },
  {
    q: 'Can I use this for a personal brand or portfolio?',
    a: 'Yes. Artists, designers, and creative technologists use premium domains for personal brands and portfolios. eDesigrs.monster gives instant credibility and recall.',
  },
];
---

<section class="max-w-3xl mx-auto px-4 sm:px-6 pb-20">
  <h2 class="font-display text-3xl tracking-tight text-center mb-8">Common questions</h2>
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group border border-white/10 rounded-2xl bg-zinc-900/50 open:bg-zinc-900">
        <summary class="min-h-12 cursor-pointer list-none px-6 py-4 font-medium flex items-center justify-between gap-4">
          <span>{faq.q}</span>
          <span class="text-zinc-500 group-open:rotate-180 transition-transform" aria-hidden="true">▾</span>
        </summary>
        <div class="px-6 pb-5 text-zinc-400 text-[15px] leading-relaxed">{faq.a}</div>
      </details>
    ))}
  </div>
</section>
