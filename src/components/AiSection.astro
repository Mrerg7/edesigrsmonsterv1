---
const points = [
  'Generative art platforms needing instant authority',
  'Electronic design agencies expanding into AI tooling',
  'Studios launching AI-assisted copy + visual systems',
  'Founders buying premium domains before competitors do',
];
---

<section id="ai" class="bg-zinc-900/60 border-y border-white/10 py-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="font-display text-[2rem] sm:text-[2.75rem] leading-[1.1] font-bold tracking-tight mb-4">
      AI + creative market fit
    </h2>
    <p class="text-zinc-400 text-lg max-w-3xl mb-8">
      Domain marketplace demand is shifting toward names that narrate the product. eDesigrs.monster reads as electronic design + creative force — perfect for AI-native brands.
    </p>
    <ul class="grid sm:grid-cols-2 gap-4">
      {points.map((point) => (
        <li class="flex gap-3 items-start text-[15px] text-zinc-300">
          <span class="mt-1 text-[var(--color-signal)]" aria-hidden="true">▸</span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
