---
const items = [
  { label: 'Escrow.com', detail: 'Buyer protection' },
  { label: 'SSL secured', detail: 'HTTPS everywhere' },
  { label: 'Guaranteed transfer', detail: '3–10 business days' },
  { label: 'Owner direct', detail: 'No broker markup' },
];
---

<section class="border-b border-white/10 bg-zinc-900/40" aria-label="Trust signals">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-5 grid grid-cols-2 md:grid-cols-4 gap-4">
    {items.map((item) => (
      <div class="min-h-12 flex flex-col justify-center">
        <p class="text-sm font-semibold text-white">{item.label}</p>
        <p class="text-xs text-zinc-500">{item.detail}</p>
      </div>
    ))}
  </div>
</section>
