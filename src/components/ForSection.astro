---
const audiences = [
  { title: 'AI art & design tools', body: 'Ship a product domain that sounds like the category leader.' },
  { title: 'Digital design agencies', body: 'Upgrade pitch decks with a brandable clients remember.' },
  { title: 'Generative artists', body: 'Anchor a portfolio and community under one sharp identity.' },
  { title: 'AI copy + art platforms', body: 'Unify multimodal creative tooling under a single mark.' },
  { title: 'Creative tech startups', body: 'Own naming before fundraising narrative locks in.' },
  { title: 'NFT & Web3 creative projects', body: 'Pair on-chain work with a memorable off-chain home.' },
];
---

<section id="for" class="max-w-5xl mx-auto px-4 sm:px-6 py-16">
  <h2 class="font-display text-[2rem] sm:text-[2.75rem] leading-[1.1] font-bold tracking-tight mb-3">
    Perfect for
  </h2>
  <p class="text-zinc-400 text-lg mb-10 max-w-2xl">
    Buyers comparing domain marketplaces for brandable and investment domains in creative tech.
  </p>
  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {audiences.map((item) => (
      <article class="hover-lift border border-white/10 rounded-2xl p-5 bg-white/[0.02]">
        <h3 class="font-semibold text-lg tracking-tight mb-2 text-white">{item.title}</h3>
        <p class="text-zinc-400 text-sm leading-relaxed">{item.body}</p>
      </article>
    ))}
  </div>
</section>
