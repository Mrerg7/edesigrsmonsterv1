---
import '../styles/global.css';
import {
  SITE,
  OG_IMAGE,
  ACQUISITION_MAILTO,
} from '../config/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = OG_IMAGE,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const canonicalHref = canonicalURL.href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: 'en-US',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${SITE.url}/portfolio/?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalHref}#webpage`,
      url: canonicalHref,
      name: title,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
      datePublished: SITE.publishedDate,
      dateModified: SITE.modifiedDate,
      inLanguage: 'en-US',
    },
    {
      '@type': 'Product',
      '@id': `${SITE.url}/#product`,
      name: 'eDesigrs.monster Premium Domain Name',
      description:
        'The definitive premium domain for electronic designers, generative artists, AI art platforms, and creative studios. Available for acquisition.',
      url: SITE.url,
      image: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630,
      },
      category: 'Premium Domain Name',
      brand: { '@type': 'Brand', name: SITE.name },
      offers: {
        '@type': 'Offer',
        url: ACQUISITION_MAILTO,
        price: String(SITE.price),
        priceCurrency: SITE.currency,
        availability: 'https://schema.org/InStock',
        priceValidUntil: '2027-09-28',
        seller: {
          '@type': 'Organization',
          name: SITE.name,
          email: SITE.email,
          url: SITE.url,
          logo: {
            '@type': 'ImageObject',
            url: ogImage,
            width: 1200,
            height: 630,
          },
        },
        shippingDetails: {
          '@type': 'OfferShippingDetails',
          shippingRate: {
            '@type': 'MonetaryAmount',
            value: '0.00',
            currency: 'USD',
          },
          deliveryTime: {
            '@type': 'ShippingDeliveryTime',
            handlingTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 1,
              unitCode: 'DAY',
            },
            transitTime: {
              '@type': 'QuantitativeValue',
              minValue: 0,
              maxValue: 0,
              unitCode: 'DAY',
            },
          },
          shippingDestination: {
            '@type': 'DefinedRegion',
            addressCountry: 'US',
          },
        },
        hasMerchantReturnPolicy: {
          '@type': 'MerchantReturnPolicy',
          returnPolicyCategory: 'https://schema.org/MerchantReturnFiniteReturnWindow',
          returnMethod: 'https://schema.org/ReturnByMail',
          returnFees: 'https://schema.org/FreeReturn',
          applicableCountry: 'US',
          merchantReturnDays: 0,
        },
      },
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '5',
        bestRating: '5',
        ratingCount: '3',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      logo: {
        '@type': 'ImageObject',
        url: ogImage,
        width: 1200,
        height: 630,
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Phoenix',
        addressRegion: 'AZ',
        addressCountry: 'US',
      },
    },
  ],
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <meta name="theme-color" content="#0b0d10" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta
      name="keywords"
      content="buy .monster domains, domain marketplace, eDesigrs.monster for sale, premium domain names, investment domains, expired domains"
    />
    <link rel="canonical" href={canonicalHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="eDesigrs.monster — Premium Domain for Electronic Designers & AI Creatives" />
    <meta property="og:locale" content={SITE.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="eDesigrs.monster — Premium Domain for Electronic Designers & AI Creatives" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://imagedelivery.net" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const light = stored === 'light';
        document.documentElement.classList.toggle('dark', !light);
        document.documentElement.classList.toggle('light', light);
        if (light) document.documentElement.classList.remove('dark');
      })();
    </script>
  </head>
  <body class="dark">
    <script is:inline>
      (() => {
        const light = localStorage.getItem('theme') === 'light';
        document.body.classList.toggle('light', light);
        document.body.classList.toggle('dark', !light);
      })();
    </script>
    <slot />
  </body>
</html>
