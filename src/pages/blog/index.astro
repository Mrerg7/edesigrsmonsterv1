---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_POSTS } from '../../data/blog';
import { SITE } from '../../config/site';

const title = `Domain Valuation Guides & Market Trends | ${SITE.brand}`;
const description =
  'Weekly domain marketplace insights: premium domain valuation, .monster TLD strategy, escrow due diligence, and acquisition success stories.';
---

<BaseLayout title={title} description={description}>
  <Nav />
  <main class="pt-24 pb-16">
    <section class="max-w-4xl mx-auto px-4 sm:px-6">
      <h1 class="font-display text-4xl sm:text-5xl tracking-tight mb-3">Guides &amp; market notes</h1>
      <p class="text-zinc-400 text-lg mb-10 max-w-2xl">
        Content for buyers researching premium domain names, investment domains, and domain marketplace strategy.
      </p>

      <div class="space-y-5">
        {BLOG_POSTS.map((post) => (
          <article class="hover-lift border border-white/10 rounded-2xl p-6 bg-white/[0.02]">
            <p class="text-xs text-zinc-500 mb-2">{post.date} · {post.readMinutes} min read</p>
            <h2 class="font-display text-2xl tracking-tight mb-2">
              <a href={`/blog/${post.slug}/`} class="hover:text-[var(--color-accent)] transition-colors">{post.title}</a>
            </h2>
            <p class="text-zinc-400 text-sm mb-4">{post.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <span class="text-[11px] uppercase tracking-wider px-2 py-1 rounded-full border border-white/10 text-zinc-500">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
